{
  "name": "towercab-3d",
  "version": "0.0.46-alpha",
  "description": "3D Tower Cab View for VATSIM Controllers",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "serve": "vite --open",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "build:converter": "python scripts/shipping/build/build_converter.py",
    "extract:surfaces": "python scripts/shipping/data-generation/extract-airport-surfaces.py",
    "dev": "node scripts/shipping/build/dev-wrapper.js",
    "dev:vnas": "node scripts/shipping/build/dev-wrapper.js --vnas",
    "release": "node scripts/shipping/build/dev-wrapper.js --release",
    "release:vnas": "node scripts/shipping/build/dev-wrapper.js --release --vnas",
    "dev:server": "pnpm run vite:build && set TOWERCAB_AUTO_SERVER=1 && tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "pnpm run typecheck && pnpm run build:converter && tauri build",
    "build:vnas": "pnpm run typecheck && pnpm run build:converter && pnpm run update:vnas && tauri build --features vnas",
    "update:vnas": "cd src-tauri && cargo update -p towercab-3d-vnas && cd ..",
    "tauri": "tauri",
    "check": "node scripts/shipping/build/check.js",
    "check:lint": "node scripts/shipping/build/check.js --lint",
    "check:types": "node scripts/shipping/build/check.js --types",
    "check:rust": "node scripts/shipping/build/check.js --rust",
    "lint": "biome check src/",
    "lint:fix": "biome check src/ --fix",
    "test": "vitest",
    "test:matching": "vitest run tests/model-matching.test.ts --reporter=verbose",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "vatsim",
    "atc",
    "tower",
    "cesium",
    "tauri"
  ],
  "author": "",
  "license": "GPL-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@tauri-apps/cli": "^2.10.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.5.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.1.0",
    "fast-xml-parser": "^5.5.8",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.3.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@babylonjs/core": "^9.2.0",
    "@babylonjs/gui": "^9.2.0",
    "@babylonjs/loaders": "^9.2.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tauri-apps/api": "~2.10",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "~2.10",
    "@turf/turf": "^7.3.4",
    "cesium": "^1.138.0",
    "egm96-universal": "^1.1.1",
    "rbush": "^4.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.4",
    "resium": "^1.19.4",
    "zustand": "^5.0.12"
  }
}
