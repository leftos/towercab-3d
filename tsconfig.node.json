{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "out-node",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "scripts/dev/**/*.ts"]
}
