+function storeysAndWallC(feature: Feature): { storeys: number; wallM: number } {
+  const isPart = isBuildingPart(feature)
+  const partLevels = isPart ? tagNumber(feature, 'part#building:levels') : Number.NaN
+  const partHeight = isPart ? tagNumber(feature, 'part#height') : Number.NaN
+  const levelKeys = Number.isNaN(partLevels) ? BUILDING_KEYS : PART_KEYS
+  const keys = Number.isNaN(partHeight) ? BUILDING_KEYS : PART_KEYS
+  const levels = Number.isNaN(partLevels) ? tagNumber(feature, 'building:levels') : partLevels
+  const height = Number.isNaN(partHeight) ? tagNumber(feature, 'height') : partHeight
+
+  const storeys = orZero(levels) - orZero(tagNumber(feature, levelKeys.minLevel))
+  if (!Number.isNaN(partLevels) && Number.isNaN(height)) return { storeys, wallM: Number.NaN }
+  const taggedHeight = !Number.isNaN(height)
+  const topM = taggedHeight ? height : tagNumber(feature, 'cesium#estimatedHeight')
+  const totalM = Math.max(topM - orZero(tagNumber(feature, keys.minHeight)), 0)
+  const roofM = taggedHeight ? roofHeight(feature, keys, totalM, storeys) : 0
+  return { storeys, wallM: totalM - roofM }
+}
