+void artCanopy(vec2 p, float T, float carport, float hash, ArtCtx c, inout vec3 col, inout vec3 emi, inout float rough) {
+  // A roof on posts: a fuel canopy's 0.9 m brand fascia on a dark drip line, or a carport's 0.3 m steel edge;
+  // under it a light (fuel) or PV (carport) underside in the top 15%, then the far side seen through.
+  float edgeLo = T - mix(0.9, 0.3, carport);
+  float underTop = edgeLo - 0.08 * (1.0 - carport);
+  col = mix(col, ${lin('#2A2A28')}, artBand(p.y, underTop, edgeLo, c.m.y) * (1.0 - carport));
+  float under = 1.0 - smoothstep(underTop - c.m.y, underTop + c.m.y, p.y);
+  float soffitLo = 0.85 * underTop;
+  float soffitZone = smoothstep(soffitLo - c.m.y, soffitLo + c.m.y, p.y);
+  vec3 soffit = mix(${lin('#9A9B98')} * 0.55, ${lin('#2C3440')}, carport);
+  vec3 inside = mix(${lin('#3E3F3C')}, soffit, soffitZone);
+  float px = p.x - floor(p.x / 8.0) * 8.0;
+  float pw = mix(0.45, 0.25, carport);
+  float post = facadeBox(vec2(px, p.y), vec2(4.0 - 0.5 * pw, -1.0), vec2(4.0 + 0.5 * pw, underTop), c.m);
+  inside = mix(inside, mix(${lin('#E9E7E1')}, ${lin('#9EA3A6')}, carport), post);
+  col = mix(col, inside, under);
+  rough = mix(rough, 0.95, under * (1.0 - post));
+  float spot = facadeBox(vec2(px, p.y), vec2(1.7, underTop - 0.1), vec2(2.1, underTop), c.m)
+    * step(0.5, facadeHash12(vec2(floor(p.x / 8.0), c.seed)));
+  vec3 fuelNight = vec3(1.0, 0.89, 0.8) * (2.0 * soffitZone + 0.12 * (1.0 - soffitZone) * (1.0 - post)) * under
+    + 0.6 * c.wall * smoothstep(edgeLo - c.m.y, edgeLo + c.m.y, p.y);
+  vec3 carportNight = vec3(1.0, 0.85, 0.6) * (0.8 * spot + 0.015 * under * soffitZone);
+  emi += c.night * mix(fuelNight, carportNight, carport);
+  // By day the open side shows the lit ground beyond and the soffit catches its bounce, so the space under the
+  // roof reads as open, never as a black box (art direction section 4).
+  vec3 seenThrough = mix(vec3(0.05, 0.05, 0.048), vec3(0.09, 0.09, 0.088) * mix(1.0, 0.35, carport), soffitZone);
+  emi += (1.0 - c.night) * under * (1.0 - post) * seenThrough;
+}
+void artRetail(vec2 p, float T, float hash, ArtCtx c, inout vec3 col, inout vec3 emi, inout float rough, inout float baseOn) {
+  // Storefront on the ground storey only: a 0.5 m split-face bulkhead, glass to 3.0 m with mullions every
+  // ~1.5 m and a transom at 2.4 m, 0.6 m tenant piers, a 1.2 m sign band with one sign per tenant, blank above.
+  float W = hash < 0.5 ? 6.0 : (hash < 1.5 ? 7.5 : (hash < 2.5 ? 9.0 : 12.0));
+  float glassTop = min(3.0, T - 1.2 - 1.3);
+  if (glassTop < 2.0) return;
+  baseOn = 0.0;
+  float ti = floor(p.x / W);
+  float tx = p.x - ti * W;
+  col = mix(col, ${lin('#A39A8C')}, 1.0 - smoothstep(0.5 - c.m.y, 0.5 + c.m.y, p.y));
+  float tenantOpen = step(0.3, facadeHash12(vec2(ti, c.seed + 4.0)));
+  float tenantI = mix(0.6, 1.0, facadeHash12(vec2(ti, c.seed + 9.0)));
+  float span = W - 0.6;
+  float panes = max(floor(span / 1.5 + 0.5), 1.0);
+  float pw = span / panes;
+  float lx = tx - 0.6;
+  float pj = floor(lx / pw);
+  vec2 q = vec2(lx - pj * pw, p.y);
+  vec2 wid = vec2(ti * 16.0 + pj, 0.0);
+  vec4 kind = vec4(0.0, 0.0, 3.0, 0.7 * tenantI);
+  float transom = step(2.7, glassTop);
+  float lowTop = mix(glassTop, 2.4, transom);
+  if (tx > 0.6) {
+    artPane(q, vec2(0.0, 0.5), vec2(pw, lowTop), pw, 3.0, wid, tenantOpen, kind, vec3(2.2), -1.0, c, col, emi, rough);
+    if (transom > 0.5) {
+      artPane(q, vec2(0.0, 2.4), vec2(pw, glassTop), pw, 3.0, wid + vec2(0.0, 1.0), tenantOpen, kind, vec3(2.2), -1.0, c, col, emi, rough);
+    }
+  }
+  float pier = facadeBox(vec2(tx, p.y), vec2(-1.0, -1.0), vec2(0.6, glassTop + 0.1), c.m);
+  col = mix(col, c.wall, pier);
+  emi *= 1.0 - pier;
+  float sLo = glassTop + 0.1;
+  float signBox = facadeBox(vec2(tx, p.y), vec2(0.6 + 0.2 * span, sLo + 0.3), vec2(0.6 + 0.8 * span, sLo + 0.9), c.m);
+  float hs = facadeHash12(vec2(ti, c.seed + 13.0));
+  vec3 signColour = hs < 0.25 ? ${lin('#7A3B32')} : (hs < 0.5 ? ${lin('#34506B')} : (hs < 0.75 ? ${lin('#5C6A3A')} : ${lin('#8A7650')}));
+  col = mix(col, signColour, signBox);
+  emi += c.night * 0.8 * signColour * signBox * tenantOpen;
+}
+void artWarehouse(vec2 p, float T, float hash, float ribShade, ArtCtx c, inout vec3 col, inout vec3 emi, inout float rough) {
+  // Tilt-up panels 8.4 m wide with joints and reveals at 1/3 and 2/3, or (hash 1) ribbed metal with a joint at
+  // 2/3; hash 2 a 0.8 m clerestory at 0.75 of the wall. Dock doors 2.7 by 3.0 m at a 1.2 m sill every 4 m in runs,
+  // in black shelters wider at the sides and top than at the foot, yellow guides and a lamp over each.
+  if (hash > 0.5 && hash < 1.5) {
+    col *= ribShade;
+    col *= 1.0 - 0.15 * artBand(p.y, 2.0 / 3.0 * T, 2.0 / 3.0 * T + 0.04, c.m.y);
+  } else {
+    float jx = p.x - floor(p.x / 8.4) * 8.4;
+    col *= 1.0 - 0.15 * c.tierA * facadeBox(vec2(jx, 0.5), vec2(-1.0), vec2(0.03, 2.0), c.m);
+    col *= 1.0 - 0.2 * (artBand(p.y, T / 3.0, T / 3.0 + 0.05, c.m.y) + artBand(p.y, 2.0 * T / 3.0, 2.0 * T / 3.0 + 0.05, c.m.y));
+  }
+  if (hash > 1.5 && hash < 2.5 && T > 6.4) {
