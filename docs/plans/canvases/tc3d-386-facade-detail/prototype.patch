+}
+void artTank(vec2 p, float T, ArtCtx c, inout vec3 col) {
+  // Shell-course lines every 2.4 m, a wind girder 0.6 m under the top over a shadow line, a 0.1 m rim, and
+  // faint grime streaks from the top (Tier A).
+  float course = p.y - floor(p.y / 2.4) * 2.4;
+  col *= 1.0 - 0.05 * artBand(course, 1.2, 1.25, c.m.y);
+  col *= 1.0 + 0.08 * artBand(p.y, T - 0.75, T - 0.6, c.m.y);
+  col *= 1.0 - 0.25 * artBand(p.y, T - 0.85, T - 0.75, c.m.y);
+  col *= 1.0 - 0.2 * smoothstep(T - 0.1 - c.m.y, T - 0.1 + c.m.y, p.y);
+  float streak = step(0.7, facadeHash12(vec2(floor(p.x / 0.7), c.seed)));
+  col *= 1.0 - 0.05 * c.tierA * streak * smoothstep(T - 4.0, T - 0.9, p.y);
+}
+// The near look per class; returns (base band on, coping on, grime on) through inout flags.
+void facadeArt(float cls, float hash, vec2 p, float T, float tagS, float ribShade, ArtCtx c,
+               inout vec3 col, inout vec3 emi, inout float rough, inout vec3 flags) {
+  float baseOn = 1.0;
+  if (cls < 0.5) {
+    artGeneric(p, T, tagS, hash, c, col, emi, rough);
+  } else if (cls < 1.5) {
+    artGarage(p, T, tagS, hash, c, col, emi, rough);
+  } else if (cls < 2.5) {
+    artHangar(p, T, ribShade, c, col, emi);
+  } else if (cls < 3.5) {
+    artHouse(p, T, tagS, hash, c, col, emi, rough, baseOn);
+  } else if (cls < 4.5) {
+    artOffice(p, T, tagS, hash, c, col, emi, rough);
+  } else if (cls < 5.5) {
+    artTerminal(p, T, c, col, emi, rough, baseOn);
+  } else if (cls < 6.5) {
+    // PLAIN: base band and coping only.
+  } else if (cls < 7.5 || cls > 12.5) {
+    artCanopy(p, T, step(12.5, cls), hash, c, col, emi, rough);
+    flags = vec3(0.0);
+    return;
+  } else if (cls < 8.5) {
+    artRetail(p, T, hash, c, col, emi, rough, baseOn);
+  } else if (cls < 9.5) {
+    artWarehouse(p, T, hash, ribShade, c, col, emi, rough);
+  } else if (cls < 10.5) {
+    artFire(p, T, hash, c, col, emi, rough, baseOn);
+  } else if (cls < 11.5) {
+    artHotel(p, T, tagS, hash, c, col, emi, rough);
+  } else {
+    artTank(p, T, c, col);
+    flags = vec3(0.0, 0.0, 1.0);
+    return;
+  }
+  flags = vec3(baseOn, 1.0, 1.0);
+}
