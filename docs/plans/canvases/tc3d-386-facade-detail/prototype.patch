+// The storey row at height h: (row, metres up from the row's floor, row height); 0 is the ground storey,
+// 1..n the upper storeys, -1 anywhere else (base band, parapet).
+vec3 artRow(float h, ArtRows r) {
+  float yG = h - 0.45;
