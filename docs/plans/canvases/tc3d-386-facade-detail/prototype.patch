+    col = mix(col, vec3(0.02) * (1.0 - c.F), clere);
+    emi += clere * c.refl * c.F;
+    rough = mix(rough, 0.6, clere);
+  }
+  if (T >= 6.1) {
+    float dw = 4.0;
+    float di = floor(p.x / dw);
+    vec2 d = vec2(p.x - di * dw, p.y);
+    float run = step(0.45, facadeHash12(vec2(floor(di / 10.0), c.seed + 5.0)));
+    float shelter = facadeBox(d, vec2(0.3, 1.15), vec2(3.7, 4.55), c.m) * run;
+    float door = facadeBox(d, vec2(0.65, 1.2), vec2(3.35, 4.2), c.m) * run;
+    float slat = 1.0 - 0.15 * c.tierA * artBand(p.y - floor(p.y / 0.15) * 0.15, 0.12, 0.14, c.m.y);
+    float guides = (facadeBox(d, vec2(0.2, -1.0), vec2(0.32, 1.2), c.m) + facadeBox(d, vec2(3.68, -1.0), vec2(3.8, 1.2), c.m)) * run * c.tierA;
+    float lamp = facadeBox(d, vec2(1.8, 4.75), vec2(2.2, 4.9), c.m) * run;
+    col = mix(col, ${lin('#1C1C1C')}, shelter);
+    col = mix(col, ${lin('#B7BCC0')} * slat, door);
+    col = mix(col, ${lin('#E3B320')}, guides);
+    col = mix(col, vec3(0.3), lamp);
+    emi += c.night * vec3(1.0, 0.75, 0.45) * (2.4 * lamp + 0.05 * door);
+  }
+  if (T > 7.5) {
+    float wx = p.x - floor(p.x / 15.0) * 15.0;
+    float pack = facadeBox(vec2(wx, p.y), vec2(7.35, 5.9), vec2(7.65, 6.15), c.m);
+    col = mix(col, vec3(0.1), pack);
+    emi += c.night * pack * vec3(1.0, 0.8, 0.55) * 2.0;
+  }
+}
+void artFire(vec2 p, float T, float hash, ArtCtx c, inout vec3 col, inout vec3 emi, inout float rough, inout float baseOn) {
+  // Apparatus bays on the ground storey only: 4.3 m doors between 0.8 m piers in a 0.25 m red surround, glazed
+  // sectional (a glass band at 0.55-0.70) or (hash 1) solid red, a header band above; crew storeys punched.
+  ArtRows r = artFit(T, 5.2, 3.2, 4.2, 1.2);
+  col *= artAttic(p.y, T, r, c.m.y);
+  if (r.groundH >= 4.6) {
+    float pitch = 5.1;
+    float bi = floor(p.x / pitch);
+    vec2 d = vec2(p.x - bi * pitch, p.y);
+    float surround = facadeBox(d, vec2(0.15, -1.0), vec2(4.95, 4.55), c.m);
+    float door = facadeBox(d, vec2(0.4, -1.0), vec2(4.7, 4.3), c.m);
+    baseOn = 1.0 - surround;
+    col = mix(col, ${lin('#B22222')}, surround);
