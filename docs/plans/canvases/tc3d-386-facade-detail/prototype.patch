+  // Ribbed metal at a 0.3 m pitch over a 1.0 m concrete wainscot, and a flat header band under the parapet;
+  // no door, which belongs on one face only (needs face extents).
+  col *= ribShade;
+  col = mix(col, ${lin('#BDB8AE')}, 1.0 - smoothstep(1.0 - c.m.y, 1.0 + c.m.y, p.y));
+  float hdrLo = T - 1.2 - 3.0;
+  if (hdrLo > 2.5) {
+    col = mix(col, c.wall * 0.95, smoothstep(hdrLo - c.m.y, hdrLo + c.m.y, p.y));
+    col *= 1.0 - 0.28 * artBand(p.y, hdrLo - 0.08, hdrLo, c.m.y);
+  }
+  emi += 0.06 * c.wall * c.night * (1.0 - smoothstep(0.0, 6.0, p.y));
+}
+void artHouse(vec2 p, float T, float tagS, float hash, ArtCtx c, inout vec3 col, inout vec3 emi, inout float rough, inout float baseOn) {
+  float lap = c.tierA * artBand(p.y - floor(p.y / 0.2) * 0.2, 0.08, 0.1, c.m.y);
+  if (hash > 2.5) {
+    // Static caravan: white lap siding, a 0.1 m trim stripe at 1.6 m and a 0.6 m dark skirting.
+    baseOn = 0.0;
+    col *= 1.0 - 0.12 * lap;
+    col = mix(col, ${lin('#7A8088')}, artBand(p.y, 1.6, 1.7, c.m.y));
+    col = mix(col, ${lin('#6D6A63')}, 1.0 - smoothstep(0.6 - c.m.y, 0.6 + c.m.y, p.y));
+    return;
+  }
+  if (hash > 1.5) col *= 1.0 - 0.1 * lap;
+  ArtRows r = artFit(T, 2.8, tagS > 0.0 ? tagS : 2.8, 4.2, 1.2);
+  col *= artAttic(p.y, T, r, c.m.y);
+  vec3 row = artRow(p.y, r);
+  if (row.x < 0.0) return;
+  float b = 3.4;
+  float bi = floor(p.x / b);
+  if (facadeHash12(vec2(bi, row.x) + vec2(c.seed, 6.0)) < 0.4) return;
