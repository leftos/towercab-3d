+}
+void artGarage(vec2 p, float T, float tagS, float hash, ArtCtx c, inout vec3 col, inout vec3 emi, inout float rough) {
+  // Concrete upstands 1.05 m over dark open decks, the slab underside lighter at the top, 0.6 m columns every 8.5 m.
+  ArtRows r = artFit(T, 3.0, tagS > 0.0 ? tagS : 3.0, 4.2, 1.2);
+  vec3 row = artRow(p.y, r);
+  if (row.x < 0.0) return;
+  float S = row.z;
+  float y = row.y;
+  float cx = p.x - floor(p.x / 8.5) * 8.5;
+  float opening = facadeBox(vec2(cx, y), vec2(0.6, 1.05), vec2(8.5 + c.m.x, S + 1.0), c.m);
+  float depth = clamp((y - 1.05) / max(S - 1.05, 0.1), 0.0, 1.0);
+  vec3 inside = mix(${lin('#121212')}, ${lin('#5A5A57')} * 0.7, smoothstep(0.72, 0.86, depth));
+  col = mix(col, inside, opening);
+  rough = mix(rough, 0.95, opening);
+  float cable = artBand(y, 1.3, 1.32, c.m.y) + artBand(y, 1.55, 1.57, c.m.y) + artBand(y, 1.8, 1.82, c.m.y);
