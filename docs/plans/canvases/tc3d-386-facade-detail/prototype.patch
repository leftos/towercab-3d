+}
+void artHotel(vec2 p, float T, float tagS, float hash, ArtCtx c, inout vec3 col, inout vec3 emi, inout float rough) {
+  // A strict room grid: 3.8 m bays, one 1.5 m window per room mirrored across the party walls, sills at 0.3 storey,
+  // a PTAC grille under each (Tier A only), brick on the lower two storeys, a 4.8 m ground storey with lobby glass
+  // on a third of its bays, and a lighter cornice in the parapet.
+  ArtRows r = artFit(T, 4.8, tagS > 0.0 ? tagS : 3.0, 4.2, 1.5);
