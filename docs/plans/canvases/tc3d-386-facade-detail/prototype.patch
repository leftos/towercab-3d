+  vec3 ledColour = hash < 0.5 ? vec3(1.0, 0.62, 0.25) : vec3(0.9, 0.95, 1.0);
+  float led = opening * artBand(y, S - 0.08 * (S - 1.05), S + 0.2, c.m.y);
